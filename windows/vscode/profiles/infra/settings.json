{
    "[dockercompose].editor.defaultFormatter": "ms-azuretools.vscode-containers",
    "[html].editor.defaultFormatter": "vscode.html-language-features",
    "[javascript].editor.defaultFormatter": "vscode.typescript-language-features",
    "[json].editor.defaultFormatter": "vscode.json-language-features",
    "[jsonc].editor.defaultFormatter": "vscode.json-language-features",
    "[markdown].editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "[yaml].editor.defaultFormatter": "redhat.vscode-yaml",
    "chat.editor.fontFamily": "FiraMono Nerd Font Mono",
    "chat.fontFamily": "FiraMono Nerd Font Mono",
    "chat.tips.enabled": false,
    "chat.tools.terminal.autoApprove.mvn clean": true,
    "chat.tools.terminal.autoApprove.mvn test": true,
    "chat.viewSessions.orientation": "stacked",
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "cSpell.userWords": [
        "adoc",
        "asciidoctor",
        "bigtwo",
        "dbml",
        "diffplug",
        "healthcheck",
        "innodb",
        "leetcode",
        "logicsolutions",
        "mysqld",
        "nums",
        "restdocs",
        "rootimes",
        "sectnums",
        "shopee",
        "sqlpackage",
        "tinyint",
        "toclevels",
        "varchar",
        "webapps"
    ],
    "debug.console.fontFamily": "FiraMono Nerd Font Mono",
    "diffEditor.ignoreTrimWhitespace": false,
    "docker.extension.enableComposeLanguageServer": false,
    "editor.codeLensFontFamily": "FiraMono Nerd Font Mono",
    "editor.cursorStyle": "underline",
    "editor.cursorSurroundingLines": 10,
    "editor.fontFamily": "FiraMono Nerd Font Mono",
    "editor.inlayHints.fontFamily": "FiraMono Nerd Font Mono",
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.fontFamily": "FiraMono Nerd Font Mono",
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.overtypeCursorStyle": "underline",
    "editor.peekWidgetDefaultFocus": "editor",
    "editor.rulers": [
        {
            "color": "#d6eaf866",
            "column": 80
        },
        {
            "color": "#85c1e966",
            "column": 100
        },
        {
            "color": "#2E86C166",
            "column": 120
        }
    ],
    "editor.tabCompletion": "on",
    "explorer.confirmDelete": false,
    "extensions.experimental.affinity": {
        "asvetliakov": {
            "vscode-neovim": 1
        },
        "asvetliakov.vscode-neovim": 1
    },
    "extensions.experimental.affinity.asvetliakov.vscode-neovim": 1,
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.enable.*": true,
    "github.copilot.enable.dockercompose": true,
    "github.copilot.enable.java": true,
    "github.copilot.enable.markdown": true,
    "github.copilot.enable.plaintext": true,
    "github.copilot.enable.scminput": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "interactiveSession.editor.fontFamily": "FiraMono Nerd Font Mono",
    "keyboard.dispatch": "keyCode",
    "markdown.preview.fontFamily": "FiraMono Nerd Font Mono",
    "notebook.markup.fontFamily": "FiraMono Nerd Font Mono",
    "notebook.output.fontFamily": "FiraMono Nerd Font Mono",
    "redhat.telemetry.enabled": true,
    "remote.SSH.remotePlatform.ge60-server": "linux",
    "remote.SSH.remotePlatform.server.wkzlife.com": "linux",
    "remote.SSH.remotePlatform.vivo15": "linux",
    "remote.SSH.remotePlatform.vivo15-server": "linux",
    "remote.SSH.remotePlatform.wkz-desktop": "windows",
    "scm.inputFontFamily": "FiraMono Nerd Font Mono",
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.focusAfterRun": "terminal",
    "terminal.integrated.fontFamily": "FiraMono Nerd Font Mono",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "todo-tree.ripgrep.ripgrep": "C:\\Users\\ru\\AppData\\Local\\Microsoft\\WinGet\\Links\\rg.exe",
    "update.mode": "none",
    "vscode-neovim.compositeKeys.jj.command": "vscode-neovim.escape",
    "vscode-neovim.ctrlKeysForNormalMode": [
        "a",
        "b",
        "backspace",
        "c",
        "delete",
        "down",
        "e",
        "f",
        "i",
        "left",
        "o",
        "r",
        "right",
        "t",
        "u",
        "up",
        "v",
        "w",
        "x",
        "y"
    ],
    "vsicons.dontShowNewVersionMessage": true,
    "window.menuBarVisibility": "classic",
    "workbench.activityBar.location": "bottom",
    "workbench.diffEditorAssociations.*.sql": "default",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.sql": "default"
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden"
}