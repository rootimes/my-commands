// 將按鍵繫結關係放在此檔案中以覆寫預設auto[]
    [
        {
            "command": "workbench.action.toggleActivityBarVisibility",
            "key": "ctrl+shift+a ctrl+shift+v"
        },
        {
            "command": "toggleVim",
            "key": "alt+win+v"
        },
        {
            "command": "workbench.action.tasks.runTask",
            "key": "ctrl+shift+t"
        },
        {
            "command": "-vscode-neovim.ctrl-f",
            "key": "ctrl+f",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.f && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.ctrl-b",
            "key": "ctrl+b",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.b && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+k",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.k && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+k",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.k && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+d",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.d && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "backspace",
            "when": "neovim.init && neovim.recording || editorTextFocus && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "backspace",
            "when": "editorTextFocus && neovim.init && focusedView == 'workbench.panel.output' && neovim.mode != 'insert'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+backspace",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.backspace && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+backspace",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.backspace && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "shift+backspace",
            "when": "neovim.init && neovim.recording || editorTextFocus && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+w",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.w && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+w",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.w && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+h",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.h && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+h",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.h && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "tab",
            "when": "neovim.init && neovim.recording || editorTextFocus && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+a",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.a && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.send",
            "key": "ctrl+a",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.a && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.escape",
            "key": "ctrl+c",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.c && neovim.init && !dirtyDiffVisible && !findWidgetVisible && !inReferenceSearchEditor && !markersNavigationVisible && !notebookCellFocused && !notificationCenterVisible && !parameterHintsVisible && !referenceSearchVisible && neovim.mode == 'normal' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-vscode-neovim.escape",
            "key": "ctrl+c",
            "when": "editorTextFocus && neovim.ctrlKeysInsert.c && neovim.init && neovim.mode != 'normal' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-list.focusPageDown",
            "key": "ctrl+d",
            "when": "listFocus && !inputFocus"
        },
        {
            "command": "-editor.action.pageDownHover",
            "key": "ctrl+d",
            "when": "editorHoverFocused"
        },
        {
            "command": "-editor.action.pageDownHover",
            "key": "ctrl+f",
            "when": "editorHoverFocused"
        },
        {
            "command": "-vscode-neovim.ctrl-d",
            "key": "ctrl+d",
            "when": "editorTextFocus && neovim.ctrlKeysNormal.d && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
        },
        {
            "command": "-editor.action.pageUpHover",
            "key": "ctrl+b",
            "when": "editorHoverFocused"
        },
        {
            "command": "-editor.action.pageUpHover",
            "key": "ctrl+u",
            "when": "editorHoverFocused"
        },
        {
            "command": "-workbench.action.decreaseViewHeight",
            "key": "ctrl+w oem_minus",
            "when": "!editorTextFocus && !isAuxiliaryWindowFocusedContext && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.decreaseViewWidth",
            "key": "ctrl+w unknown",
            "when": "!editorTextFocus && !isAuxiliaryWindowFocusedContext && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.increaseViewHeight",
            "key": "ctrl+w unknown",
            "when": "!editorTextFocus && !isAuxiliaryWindowFocusedContext && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.increaseViewWidth",
            "key": "ctrl+w unknown",
            "when": "!editorTextFocus && !isAuxiliaryWindowFocusedContext && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.closeActiveEditor",
            "key": "ctrl+w q",
            "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.focusNextGroup",
            "key": "ctrl+w ctrl+w",
            "when": "!editorTextFocus && !filesExplorerFocus && !inSearchEditor && !replaceInputBoxFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateUp",
            "key": "ctrl+w up",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateUp",
            "key": "ctrl+w k",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateDown",
            "key": "ctrl+w down",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateDown",
            "key": "ctrl+w j",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateLeft",
            "key": "ctrl+w left",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateLeft",
            "key": "ctrl+w h",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateRight",
            "key": "ctrl+w right",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.navigateRight",
            "key": "ctrl+w l",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.toggleEditorWidths",
            "key": "ctrl+w unknown",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.splitEditorRight",
            "key": "ctrl+w v",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.splitEditorDown",
            "key": "ctrl+w s",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-workbench.action.evenEditorWidths",
            "key": "ctrl+w oem_plus",
            "when": "!editorTextFocus && !terminalFocus && neovim.mode != 'cmdline'"
        },
        {
            "command": "-vscode-neovim.send-cmdline",
            "key": "ctrl+h",
            "when": "neovim.init && neovim.mode == 'cmdline'"
        },
        {
            "command": "-vscode-neovim.send-cmdline",
            "key": "tab",
            "when": "neovim.init && neovim.mode == 'cmdline'"
        },
        {
            "command": "-togglePeekWidgetFocus",
            "key": "tab",
            "when": "referenceSearchVisible || inReferenceSearchEditor && neovim.mode == 'normal'"
        },
        {
            "command": "-workbench.action.quickOpen",
            "key": "ctrl+e"
        }
    ]